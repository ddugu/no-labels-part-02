rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /flavors_entries/{entryId} {
      allow create: if validEntry();
      allow read, delete: if request.auth != null;
      allow update: if false;

      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'event', 'image', 'ts'])
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 40
          && d.event == 'CHOOSING THE FLAVORS'
          && d.image is string
          && d.image.matches('^data:image/jpeg;base64,.*')
          && d.image.size() < 1040000
          && d.ts is number;
      }
    }
  }
}
